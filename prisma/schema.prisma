// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.Text
  rating    Int
  createdAt DateTime @default(now())
}

model Camp {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  title        String
  location     String
  startDate    DateTime
  endDate      DateTime
  capacity     Int
  mapUrl       String?
  allowBringFriend Boolean @default(false)
  price        Decimal
  deposit      Decimal

  subtitle     String?
  tags         String[]
  heroImage    String?
  description  String?  @db.Text
  services     CampService[]
  blocks       Json?    @default("[]")

  // ── SEO (mirror modelu Post) ─────────────────────
  metaTitle       String?
  metaDescription String?  @db.Text
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  // ─────────────────────────────────────────────────

  lastAiPrompt String?  @db.Text
  lastStage    String   @default("dane-podstawowe")
  isFeatured   Boolean  @default(false)
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  views        Int      @default(0)

  bookings     Booking[]
  events       CampEvent[]
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campId    String
  camp      Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  // Powiązanie z kontem uczestniczki (wypełniane po rejestracji / dopasowaniu e-mail)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  name      String?
  email     String
  phone     String?

  // PENDING | DEPOSIT_PAID | FULLY_PAID | CANCELLED | PENDING_INVITATION | EXPIRED
  status    String   @default("PENDING")

  // --- Bilet QR ---
  qrToken   String   @unique @default(cuid())

  // --- Check-in (skaner admina) ---
  isCheckedIn Boolean  @default(false)
  checkedInAt DateTime?

  // --- Płatności ---
  depositPaidAt   DateTime?
  remainderPaidAt DateTime?

  // --- Stripe ---
  stripeSessionId       String?   @unique // legacy (Checkout Session)
  stripePaymentIntentId String?   @unique
  amountTotal     Int       @default(0) // grosze
  amountPaid      Int       @default(0) // grosze

  // --- Zaproszenia "zabierz przyjaciółkę" ---
  invitedById   String?
  invitedBy     Booking?  @relation("FriendInvitation", fields: [invitedById], references: [id])
  invitedGuests Booking[] @relation("FriendInvitation")
  invitationToken String? @unique
  expiresAt     DateTime?

  serviceOrders ServiceOrder[]
}

model Post {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  coverImage      String?
  category        String    @default("Ogólne")
  tags            String[]
  author          String    @default("Piotr Siemaszko")
  readTime        Int?

  content         Json?     @default("[]")

  metaTitle       String?
  metaDescription String?   @db.Text
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean   @default(false)

  status          String    @default("DRAFT")
  publishedAt     DateTime?
  lastStage       String    @default("dane-podstawowe")
}

model BlogScheduleEntry {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  scheduledDate DateTime?
  title         String
  topic         String   @db.Text
  category      String
  keywords      String[]
  status        String   @default("PLANNED") // PLANNED | IN_PROGRESS | PUBLISHED | SKIPPED

  postId        String?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ExtraService {
  id          String   @id @default(cuid())
  name        String
  duration    Int
  price       Decimal
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CampService {
  id          String   @id @default(cuid())
  name        String
  duration    Int      // minuty
  price       Decimal
  description String?  @db.Text

  campId      String
  camp        Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  slots       ServiceSlot[]
  orders      ServiceOrder[]
}

// Ogólny punkt harmonogramu wyjazdu widoczny dla wszystkich uczestniczek
model CampEvent {
  id          String        @id @default(cuid())
  campId      String
  camp        Camp          @relation(fields: [campId], references: [id], onDelete: Cascade)

  title       String
  description String?       @db.Text
  startTime   DateTime      // pełna data + godzina
  endTime     DateTime?
  type        CampEventType @default(GENERAL)
  icon        String?       // nazwa ikony z @phosphor-icons
  isPublished Boolean       @default(true)
  sortOrder   Int           @default(0)

  createdAt   DateTime      @default(now())
}

enum CampEventType {
  GENERAL
  MEAL
  ACTIVITY
  WELLNESS_FREE
  ANNOUNCEMENT
}

// Okienko czasowe na usługę, definiowane przez admina
model ServiceSlot {
  id        String      @id @default(cuid())
  serviceId String
  service   CampService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  startTime DateTime    // pełna data + godzina
  endTime   DateTime    // startTime + service.duration

  isActive  Boolean     @default(true)

  // @unique gwarantuje na poziomie DB brak double-bookingów
  order     ServiceOrder?

  createdAt DateTime    @default(now())
}

// Rezerwacja konkretnego slotu przez uczestniczkę
model ServiceOrder {
  id        String   @id @default(cuid())

  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  slotId    String      @unique
  slot      ServiceSlot @relation(fields: [slotId], references: [id])

  // Denormalizacja — szybki dostęp bez JOIN
  serviceId String
  service   CampService @relation(fields: [serviceId], references: [id])

  price     Decimal  // snapshot ceny z momentu rezerwacji

  // PENDING | PAID | CANCELLED
  status          String   @default("PENDING")
  paymentIntentId String?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Karta zdrowia uczestniczki — 1:1 z User (trwałe, reużywane między wyjazdami)
model HealthProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dietType         String?   // OMNIVORE | VEGETARIAN | VEGAN | OTHER
  foodIntolerances String[]
  foodNotes        String?   @db.Text

  chronicConditions String?  @db.Text
  medications       String?  @db.Text
  injuries          String?  @db.Text
  allergies         String?  @db.Text

  emergencyName  String?
  emergencyPhone String?

  updatedAt DateTime @updatedAt
}
model Activity {
  id        String   @id @default(cuid())
  pillar    String   // np. "CAMP", "VOD", "BLOG", "SYSTEM"
  kind      String   // np. "PAYMENT", "SIGNUP", "HEALTH_FILLED"
  who       String   // np. "Kasia R." albo "System"
  text      String   // np. "Opłaciła zadatek"
  meta      String?  // np. "+600 zł" (opcjonalne)
  createdAt DateTime @default(now())
}
// ==========================================
// AUTORYZACJA (NEXTAUTH)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role          Role      @default(USER)

  // --- Powiadomienia (OneSignal + in-app) ---
  isNotificationEnabled  Boolean   @default(false)
  notificationPromptedAt DateTime?
  oneSignalPlayerId      String?

  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  healthProfile HealthProfile?
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String?  @db.Text
  // INFO | SUCCESS | WARNING | BOOKING | PAYMENT | HEALTH | SPA | SYSTEM
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
