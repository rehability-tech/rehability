// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.Text
  rating    Int
  createdAt DateTime @default(now())
}
// Dodaj to do swojego pliku schema.prisma

enum DietType {
  OMNIVORE
  VEGETARIAN
  VEGAN
  OTHER
}

model HealthProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  dietType          DietType @default(OMNIVORE)
  foodIntolerances  String[] // Tablica stringów (PostgreSQL wspiera natywnie, na MySQL/SQLite też działa)
  foodNotes         String?  @db.Text
  
  chronicConditions String?  @db.Text
  medications       String?  @db.Text
  injuries          String?  @db.Text
  allergies         String?  @db.Text
  
  emergencyName     String?
  emergencyPhone    String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
model Trip {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  title        String
  location     String
  startDate    DateTime
  endDate      DateTime
  capacity     Int
  mapUrl       String?
  allowBringFriend Boolean @default(false)
  price        Decimal
  deposit      Decimal

  subtitle     String?
  tags         String[]
  heroImage    String?
  description  String?  @db.Text
  services     TripService[]
  spaBlocks    SpaBlock[]
  blocks       Json?    @default("[]")
isSchedulePublished Boolean @default(false)
  // ── SEO (mirror modelu Post) ─────────────────────
  metaTitle       String?
  metaDescription String?  @db.Text
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  // ─────────────────────────────────────────────────

  lastAiPrompt String?  @db.Text
  lastStage    String   @default("dane-podstawowe")

  // ── E-MAIL ZAPROSZENIA (allowBringFriend) ─────────────────────
  invitationEmailTitle      String?
  invitationEmailSubject    String?
  invitationEmailBody       String?  @db.Text
  invitationEmailButtonText String?
  invitationEmailHeroImage  String?
  invitationEmailHighlights Json?
  invitationEmailGallery    String[]
  invitationEmailSections   Json?
  // ──────────────────────────────────────────────────────────────
  isFeatured   Boolean  @default(false)
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  views        Int      @default(0)

  bookings     Booking[]
  events       TripEvent[]
  pageViews    TripView[]
  activities   Activity[]
  messages     Message[]
}

// Wiadomość w grupowym czacie wyjazdowym (uczestniczki + organizator).
model Message {
  id        String   @id @default(cuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Flaga ułatwiająca wyróżnianie dymków organizatora na froncie.
  isAdmin   Boolean  @default(false)

  @@index([tripId, createdAt])
}
// DO DODANIA NA DOLE PLIKU SCHEMA.PRISMA:

model SystemUpdate {
  id          String   @id @default(cuid())
  type        String   // "VOD" | "CAMP" | "BLOG" | "SYSTEM"
  title       String
  description String   @db.Text
  link        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}
model TripView {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  visitorHash String
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([tripId, visitorHash, day])
  @@index([tripId, day])
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Powiązanie z kontem uczestniczki (wypełniane po rejestracji / dopasowaniu e-mail)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  name      String?
  email     String
  phone     String?

  // PENDING | DEPOSIT_PAID | FULLY_PAID | CANCELLED | PENDING_INVITATION | EXPIRED
  status    String   @default("PENDING")

  // --- Bilet QR ---
  qrToken   String   @unique @default(cuid())

  // --- Check-in (skaner admina) ---
  isCheckedIn Boolean  @default(false)
  checkedInAt DateTime?

  // --- Płatności ---
  depositPaidAt   DateTime?
  remainderPaidAt DateTime?

  // --- Stripe ---
  stripeSessionId       String?   @unique // legacy (Checkout Session)
  stripePaymentIntentId String?   @unique
  amountTotal     Int       @default(0) // grosze
  amountPaid      Int       @default(0) // grosze

  // --- Zaproszenia "zabierz przyjaciółkę" ---
  invitedById   String?
  invitedBy     Booking?  @relation("FriendInvitation", fields: [invitedById], references: [id])
  invitedGuests Booking[] @relation("FriendInvitation")
  invitationToken String? @unique
  expiresAt     DateTime?

  serviceOrders ServiceOrder[]
}

model Post {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  coverImage      String?
  category        String    @default("Ogólne")
  tags            String[]
  author          String    @default("Piotr Siemaszko")
  readTime        Int?

  content         Json?     @default("[]")

  metaTitle       String?
  metaDescription String?   @db.Text
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean   @default(false)

  status          String    @default("DRAFT")
  publishedAt     DateTime?
  lastStage       String    @default("dane-podstawowe")
}

model BlogScheduleEntry {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  scheduledDate DateTime?
  title         String
  topic         String   @db.Text
  category      String
  keywords      String[]
  status        String   @default("PLANNED") // PLANNED | IN_PROGRESS | PUBLISHED | SKIPPED

  postId        String?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ExtraService {
  id          String   @id @default(cuid())
  name        String
  duration    Int
  price       Decimal
  description String?  @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Kopie tej usługi przypisane do konkretnych wyjazdów (umożliwia propagację edycji)
  tripServices TripService[]
}

model TripService {
  id          String   @id @default(cuid())
  name        String
  duration    Int      // minuty
  price       Decimal
  description String?  @db.Text
  image       String?

  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Powiązanie z globalnym katalogiem (ExtraService). Null = usługa tylko dla tego campu.
  sourceServiceId String?
  sourceService   ExtraService? @relation(fields: [sourceServiceId], references: [id], onDelete: SetNull)

  orders      ServiceOrder[]
  spaBlocks   SpaBlockService[]

  @@index([sourceServiceId])
}

// Ogólny punkt harmonogramu wyjazdu widoczny dla wszystkich uczestniczek
model TripEvent {
  id          String        @id @default(cuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  title       String
  description String?       @db.Text
  startTime   DateTime      // pełna data + godzina
  endTime     DateTime?
  type        TripEventType @default(GENERAL)
  icon        String?       // nazwa ikony z @phosphor-icons
  isPublished Boolean       @default(true)
  sortOrder   Int           @default(0)

  createdAt   DateTime      @default(now())
}

enum TripEventType {
  GENERAL
  MEAL
  ACTIVITY
  WELLNESS_FREE
  ANNOUNCEMENT
}

// Otwarty "Pusty Blok SPA" definiowany przez admina.
// Nie jest przypisany do konkretnej usługi — uczestniczka wybiera usługę
// dopiero w trakcie rezerwacji. Capacity = ile równoległych rezerwacji
// (różnych usług) mieści się w tym przedziale czasowym.
model SpaBlock {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime
  capacity  Int      @default(1)
  isActive  Boolean  @default(true)

  // true = wolny blok: każda usługa z katalogu, sumarycznie `capacity` rezerwacji.
  // false = whitelist z per-service capacity (patrz `serviceCapacities`).
  isOpen            Boolean            @default(true)
  serviceCapacities SpaBlockService[]

  orders    ServiceOrder[]

  createdAt DateTime @default(now())
}

// Pivot SpaBlock <-> TripService z capacity per usługa.
// Istnieje tylko dla bloków whitelistowych (SpaBlock.isOpen = false).
model SpaBlockService {
  spaBlockId String
  spaBlock   SpaBlock    @relation(fields: [spaBlockId], references: [id], onDelete: Cascade)

  serviceId  String
  service    TripService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  capacity   Int

  @@id([spaBlockId, serviceId])
  @@index([serviceId])
}

// Rezerwacja konkretnej usługi w wybranym bloku SPA
model ServiceOrder {
  id        String   @id @default(cuid())

  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  spaBlockId String
  spaBlock   SpaBlock @relation(fields: [spaBlockId], references: [id], onDelete: Cascade)

  serviceId String
  service   TripService @relation(fields: [serviceId], references: [id])

  // Faktyczny przedział czasowy zarezerwowany w bloku.
  // Wolny blok: sub-slot wybrany przez klientkę. Whitelist: pokrywa cały blok.
  // TEMP nullable — backfill ze SpaBlock, potem podniesiemy na required.
  startTime DateTime?
  endTime   DateTime?

  price     Decimal  // snapshot ceny z momentu rezerwacji

  // PENDING | PAID | CANCELLED
  status            String    @default("PENDING")
  stripeSessionId   String?   @unique
  paymentIntentId   String?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaBlockId, status])
}

model Activity {
  id        String   @id @default(cuid())
  tripId    String?  // <--- DODANE POLE
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  pillar    String   // np. "CAMP"
  kind      String   // np. "PAYMENT"
  who       String   // np. "Anna Kowalska"
  text      String   // np. "Opłaciła zadatek"
  meta      String?  // Dodatkowe dane, np. json z kwotą
  createdAt DateTime @default(now())
}
// ==========================================
// AUTORYZACJA (NEXTAUTH)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role          Role      @default(USER)

  // --- Powiadomienia (OneSignal + in-app) ---
  isNotificationEnabled  Boolean   @default(false)
  notificationPromptedAt DateTime?
  oneSignalPlayerId      String?

  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  healthProfile HealthProfile?
  notifications Notification[]
  messages      Message[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String?  @db.Text
  // INFO | SUCCESS | WARNING | BOOKING | PAYMENT | HEALTH | SPA | SYSTEM
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
