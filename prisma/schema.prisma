// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.Text
  rating    Int
  createdAt DateTime @default(now())
}
// Dodaj to do swojego pliku schema.prisma

enum DietType {
  OMNIVORE
  VEGETARIAN
  VEGAN
  OTHER
}

model HealthProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  dietType          DietType @default(OMNIVORE)
  foodIntolerances  String[] // Tablica stringów (PostgreSQL wspiera natywnie, na MySQL/SQLite też działa)
  foodNotes         String?  @db.Text
  
  chronicConditions String?  @db.Text
  medications       String?  @db.Text
  injuries          String?  @db.Text
  allergies         String?  @db.Text
  
  emergencyName     String?
  emergencyPhone    String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
model Trip {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  title        String
  location     String
  startDate    DateTime
  endDate      DateTime
  capacity     Int
  mapUrl       String?
  allowBringFriend Boolean @default(false)
  price        Decimal
  deposit      Decimal

  // ── Okno zapisów ──────────────────────────────────────────────
  // Termin zamknięcia zapisów online. NULL = zapisy otwarte do dnia
  // rozpoczęcia (startDate). Po tej dacie publiczny formularz znika.
  registrationDeadline DateTime?
  // Ręczne zamknięcie zapisów przez admina (np. gdy pokoje są już
  // zaklepane). Wydarzenie zostaje widoczny, ale bez formularza rezerwacji.
  registrationClosed   Boolean  @default(false)
  // ──────────────────────────────────────────────────────────────

  subtitle     String?
  tags         String[]
  heroImage    String?
  description  String?  @db.Text
  services     TripService[]
  spaBlocks    SpaBlock[]
  blocks       Json?    @default("[]")
isSchedulePublished Boolean @default(false)
  // ── SEO (mirror modelu Post) ─────────────────────
  metaTitle       String?
  metaDescription String?  @db.Text
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  // ─────────────────────────────────────────────────

  lastAiPrompt String?  @db.Text
  lastStage    String   @default("dane-podstawowe")

  // ── E-MAIL ZAPROSZENIA (allowBringFriend) ─────────────────────
  invitationEmailTitle      String?
  invitationEmailSubject    String?
  invitationEmailBody       String?  @db.Text
  invitationEmailButtonText String?
  invitationEmailHeroImage  String?
  invitationEmailHighlights Json?
  invitationEmailGallery    String[]
  invitationEmailSections   Json?
  // ──────────────────────────────────────────────────────────────
  isFeatured   Boolean  @default(false)
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  views        Int      @default(0)

  // ── System rabatowy / piaskownica ─────────────────────────────
  // Piaskownica: wszystko utworzone lub zmienione przy włączonym trybie
  // dostaje isSandbox=true i widzi to wyłącznie osoba z dostępem do
  // piaskownicy. Tryb NIE wyłącza trwających promocji — izoluje tylko to,
  // co w nim powstanie.
  sandbox          Boolean   @default(false)
  sandboxEnabledAt DateTime?
  // Cena i zadatek obowiązujące TYLKO w piaskownicy (złotówki, jak price
  // i deposit). "Opublikuj i wyłącz" przepisuje je do price/deposit
  // i czyści te pola.
  sandboxPrice   Decimal?
  sandboxDeposit Decimal?

  discountCodes  DiscountCode[]
  sales          Sale[]
  emailDiscounts EmailDiscount[]
  // ──────────────────────────────────────────────────────────────

  bookings     Booking[]
  events       TripEvent[]
  pageViews    TripView[]
  activities   Activity[]
  messages     Message[]
}

// Wiadomość w grupowym czacie wyjazdowym (uczestniczki + organizator).
model Message {
  id        String   @id @default(cuid())
  text      String   @db.Text
  createdAt DateTime @default(now())

  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Flaga ułatwiająca wyróżnianie dymków organizatora na froncie.
  isAdmin   Boolean  @default(false)

  @@index([tripId, createdAt])
}
// DO DODANIA NA DOLE PLIKU SCHEMA.PRISMA:

model SystemUpdate {
  id          String   @id @default(cuid())
  type        String   // "VOD" | "CAMP" | "BLOG" | "SYSTEM"
  title       String
  description String   @db.Text
  link        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}
model TripView {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  visitorHash String
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([tripId, visitorHash, day])
  @@index([tripId, day])
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Powiązanie z kontem uczestniczki (wypełniane po rejestracji / dopasowaniu e-mail)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  name      String?
  email     String
  phone     String?

  // PENDING | DEPOSIT_PAID | FULLY_PAID | CANCELLED | PENDING_INVITATION | EXPIRED
  status    String   @default("PENDING")

  // --- Bilet QR ---
  qrToken   String   @unique @default(cuid())

  // --- Check-in (skaner admina) ---
  isCheckedIn Boolean  @default(false)
  checkedInAt DateTime?

  // --- Płatności ---
  depositPaidAt   DateTime?
  remainderPaidAt DateTime?

  // --- Stripe ---
  stripeSessionId       String?   @unique // legacy (Checkout Session)
  stripePaymentIntentId String?   @unique
  amountTotal     Int       @default(0) // grosze
  amountPaid      Int       @default(0) // grosze
  // Zadatek PO rabacie, w GROSZACH. Źródło prawdy dla resume-payment —
  // bez tego pola wznowiona rezerwacja liczyłaby zadatek od nowa
  // z trip.deposit i obciążyła pełną kwotą, ignorując udzielony rabat.
  amountDeposit   Int       @default(0) // grosze

  // --- Snapshot rabatów (WARTOŚCI, nie referencje) ---
  // Świadomie BEZ kluczy obcych: skasowanie promocji nie psuje historii.
  // Statystyki joinujemy po *Id, a *Name/discountCode służą do pokazania
  // rekordu osieroconego (promocja usunięta po zakupie).
  originalAmount      Int?      // grosze — cena bazowa przed rabatami
  totalDiscountAmount Int       @default(0) // grosze — suma rabatów

  discountCodeId     String?
  discountCode       String?
  discountCodeAmount Int?

  saleId     String?
  saleName   String?
  saleAmount Int?

  emailDiscountId     String?
  emailDiscountName   String?
  emailDiscountAmount Int?

  // Rezerwacja z piaskownicy — nie liczy się do statystyk rabatów
  // i nie zjada limitów użyć.
  isSandbox Boolean @default(false)

  // --- Zaproszenia "zabierz przyjaciółkę" ---
  invitedById   String?
  invitedBy     Booking?  @relation("FriendInvitation", fields: [invitedById], references: [id])
  invitedGuests Booking[] @relation("FriendInvitation")
  invitationToken String? @unique
  expiresAt     DateTime?

  serviceOrders ServiceOrder[]

  @@index([discountCodeId])
  @@index([saleId])
  @@index([emailDiscountId])
}

model Post {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  coverImage      String?
  category        String    @default("Ogólne")
  tags            String[]
  author          String    @default("Piotr Siemaszko")
  readTime        Int?

  content         Json?     @default("[]")

  metaTitle       String?
  metaDescription String?   @db.Text
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean   @default(false)

  status          String    @default("DRAFT")
  publishedAt     DateTime?
  lastStage       String    @default("dane-podstawowe")

  views           Int       @default(0)
  pageViews       PostView[]
}

model PostView {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorHash String
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([postId, visitorHash, day])
  @@index([postId, day])
}

model BlogScheduleEntry {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  scheduledDate DateTime?
  title         String
  topic         String   @db.Text
  category      String
  keywords      String[]
  status        String   @default("PLANNED") // PLANNED | IN_PROGRESS | PUBLISHED | SKIPPED

  postId        String?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ExtraService {
  id          String   @id @default(cuid())
  name        String
  duration    Int
  price       Decimal
  description String?  @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Kopie tej usługi przypisane do konkretnych wydarzeń (umożliwia propagację edycji)
  tripServices TripService[]
}

model TripService {
  id          String   @id @default(cuid())
  name        String
  duration    Int      // minuty
  price       Decimal
  description String?  @db.Text
  image       String?

  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Powiązanie z globalnym katalogiem (ExtraService). Null = usługa tylko dla tego campu.
  sourceServiceId String?
  sourceService   ExtraService? @relation(fields: [sourceServiceId], references: [id], onDelete: SetNull)

  orders      ServiceOrder[]
  spaBlocks   SpaBlockService[]

  @@index([sourceServiceId])
}

// Ogólny punkt harmonogramu wydarzenia widoczny dla wszystkich uczestniczek
model TripEvent {
  id          String        @id @default(cuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  title       String
  description String?       @db.Text
  startTime   DateTime      // pełna data + godzina
  endTime     DateTime?
  type        TripEventType @default(GENERAL)
  icon        String?       // nazwa ikony z @phosphor-icons
  isPublished Boolean       @default(true)
  sortOrder   Int           @default(0)

  createdAt   DateTime      @default(now())
}

enum TripEventType {
  GENERAL
  MEAL
  ACTIVITY
  WELLNESS_FREE
  ANNOUNCEMENT
}

// Otwarty "Pusty Blok SPA" definiowany przez admina.
// Nie jest przypisany do konkretnej usługi — uczestniczka wybiera usługę
// dopiero w trakcie rezerwacji. Capacity = ile równoległych rezerwacji
// (różnych usług) mieści się w tym przedziale czasowym.
model SpaBlock {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  startTime DateTime
  endTime   DateTime
  capacity  Int      @default(1)
  isActive  Boolean  @default(true)

  // true = wolny blok: każda usługa z katalogu, sumarycznie `capacity` rezerwacji.
  // false = whitelist z per-service capacity (patrz `serviceCapacities`).
  isOpen            Boolean            @default(true)
  serviceCapacities SpaBlockService[]

  orders    ServiceOrder[]

  createdAt DateTime @default(now())
}

// Pivot SpaBlock <-> TripService z capacity per usługa.
// Istnieje tylko dla bloków whitelistowych (SpaBlock.isOpen = false).
model SpaBlockService {
  spaBlockId String
  spaBlock   SpaBlock    @relation(fields: [spaBlockId], references: [id], onDelete: Cascade)

  serviceId  String
  service    TripService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  capacity   Int

  @@id([spaBlockId, serviceId])
  @@index([serviceId])
}

// Rezerwacja konkretnej usługi w wybranym bloku SPA
model ServiceOrder {
  id        String   @id @default(cuid())

  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  spaBlockId String
  spaBlock   SpaBlock @relation(fields: [spaBlockId], references: [id], onDelete: Cascade)

  serviceId String
  service   TripService @relation(fields: [serviceId], references: [id])

  // Faktyczny przedział czasowy zarezerwowany w bloku.
  // Wolny blok: sub-slot wybrany przez klientkę. Whitelist: pokrywa cały blok.
  // TEMP nullable — backfill ze SpaBlock, potem podniesiemy na required.
  startTime DateTime?
  endTime   DateTime?

  price     Decimal  // snapshot ceny z momentu rezerwacji

  // PENDING | PAID | CANCELLED
  status            String    @default("PENDING")
  stripeSessionId   String?   @unique
  paymentIntentId   String?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaBlockId, status])
}

model Activity {
  id        String   @id @default(cuid())
  tripId    String?  // <--- DODANE POLE
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  pillar    String   // np. "CAMP"
  kind      String   // np. "PAYMENT"
  who       String   // np. "Anna Kowalska"
  text      String   // np. "Opłaciła zadatek"
  meta      String?  // Dodatkowe dane, np. json z kwotą
  createdAt DateTime @default(now())
}
// ==========================================
// AUTORYZACJA (NEXTAUTH)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role          Role      @default(USER)

  // --- Piaskownica ---
  // Dostęp do trybu testowego nadawany PER KONTO. Administrator ma go zawsze
  // z racji roli (patrz viewerCanUseSandbox) — ta flaga służy do nadania
  // dostępu komuś, kto adminem nie jest (np. osoba testująca promocje).
  sandboxAccess    Boolean   @default(false)
  sandboxGrantedAt DateTime?

  // --- Powiadomienia (OneSignal + in-app) ---
  isNotificationEnabled  Boolean   @default(false)
  notificationPromptedAt DateTime?
  oneSignalPlayerId      String?

  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  healthProfile HealthProfile?
  notifications Notification[]
  messages      Message[]
  enrollments   Enrollment[]
  lessonProgress LessonProgress[]
  courseReviews CourseReview[]
  courseFavorites CourseFavorite[]
  coursePurchases CoursePurchase[]

  // Powiązanie z rekordem kontaktu w module mailingowym (1:1, opcjonalne).
  contact       Contact?
}

// ===== PLATFORMA VOD (KURSY) =====

model Course {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  category     String
  excerpt      String   @db.Text
  price        Int      @default(0)
  durationMin  Int      @default(0)
  // Zagregowane oceny (cache liczony z CourseReview): rating = średnia, reviews = liczba.
  rating       Float    @default(0)
  reviews      Int      @default(0)
  // Licznik wyświetleń strony kursu (cache; szczegóły dedupowane w CourseView).
  views        Int      @default(0)
  // "single" = jeden film, "sections" = moduły/lekcje
  format       String   @default("sections")
  video        String?  // główne wideo (single) lub zwiastun
  // Długość głównego wideo w sekundach (format „single"; z Bunny).
  videoDurationSec Int  @default(0)
  image        String?  // miniatura (opcjonalnie; VOD bierze z wideo)
  // DRAFT | PUBLISHED | ARCHIVED
  status       String   @default("PUBLISHED")
  // elastyczne pola treści
  description  Json?   // bloki zakładki „O kursie"
  content      Json?   // bloki zakładki „Zawartość" (opis co kurs zawiera)
  faq          Json?
  // ── SEO (mirror modelu Post/Trip) ─────────────────
  metaTitle       String?
  metaDescription String?  @db.Text
  focusKeyword    String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  // ─────────────────────────────────────────────────
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Data PIERWSZEJ publikacji (status → PUBLISHED). Null = nigdy nie publikowany.
  // Używana w panelu do alertów „mało kursantów" dopiero po okresie karencji.
  publishedAt  DateTime?

  // Kurs widoczny wyłącznie dla osób z dostępem do piaskownicy.
  // Na razie nieużywane przez kod VOD — kolumna istnieje w bazie i czeka
  // na analogiczny tryb testowy po stronie kursów (system rabatowy używa
  // własnego przełącznika na Trip).
  sandbox      Boolean  @default(false)

  modules       CourseModule[]
  enrollments   Enrollment[]
  courseReviews CourseReview[]
  pageViews     CourseView[]
  favorites     CourseFavorite[]
  purchases     CoursePurchase[]

  // System rabatowy — te same modele co przy wydarzeniach, patrz komentarz
  // „WŁAŚCICIEL PROMOCJI" niżej w pliku.
  discountCodes  DiscountCode[]
  sales          Sale[]
  emailDiscounts EmailDiscount[]

  @@index([status, sandbox])
}

// Ulubione/„zapisane" kursy użytkownika. Gość trzyma to w localStorage; po
// zalogowaniu migrujemy do bazy i każdy kolejny zapis ląduje tutaj.
model CourseFavorite {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

model CourseView {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  visitorHash String
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([courseId, visitorHash, day])
  @@index([courseId, day])
}

// Utrwalony rekord zakupu kursu (do faktur i realnego przychodu). Enrollment
// nadaje sam dostęp; tu zapisujemy KWOTĘ zapłaconą w chwili sprzedaży oraz
// snapshot danych rozliczeniowych — dzięki temu edycja ceny kursu nie zmienia
// historycznego przychodu. Idempotentne po paymentIntentId (webhook + fallback).
model CoursePurchase {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Klucz idempotencji — jeden PaymentIntent = jeden rekord.
  paymentIntentId String   @unique
  // Kwota realnie zapłacona w GROSZACH (amount_received ze Stripe).
  amount          Int
  currency        String   @default("pln")
  // Snapshot danych rozliczeniowych z checkoutu (do faktur; wszystkie opcjonalne).
  buyerType       String?
  buyerName       String?
  buyerEmail      String?
  company         String?
  nip             String?
  address         String?
  postalCode      String?
  city            String?

  // --- Snapshot rabatów (WARTOŚCI, nie referencje) ---
  // Lustro pól z Booking. Świadomie bez kluczy obcych: skasowanie promocji
  // nie może naruszyć historii zakupów. Statystyki joinujemy po *Id.
  originalAmount      Int?      // grosze — cena przed rabatami
  totalDiscountAmount Int       @default(0)

  discountCodeId     String?
  discountCode       String?
  discountCodeAmount Int?

  saleId     String?
  saleName   String?
  saleAmount Int?

  emailDiscountId     String?
  emailDiscountName   String?
  emailDiscountAmount Int?

  // Zakup z piaskownicy — nie liczy się do statystyk i nie zjada limitów.
  isSandbox Boolean @default(false)

  createdAt       DateTime @default(now())

  @@index([courseId])
  @@index([userId])
  @@index([discountCodeId])
  @@index([saleId])
  @@index([emailDiscountId])
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1–5
  text      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Jeden kursant = jedna opinia per kurs (można edytować własną).
  @@unique([courseId, userId])
  @@index([courseId])
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  lessons   Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String         @id @default(cuid())
  moduleId    String
  module      CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  video       String?
  // Długość nagrania w sekundach (z Bunny) — do liczenia czasu kursu.
  durationSec Int            @default(0)
  order       Int            @default(0)
  progress    LessonProgress[]

  @@index([moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  // Ukończenie kursu: single → po obejrzeniu filmu; moduły → po ostatniej lekcji.
  completedAt DateTime?
  // Postęp oglądania głównego filmu (format „single"; sekundy). Dla kursów
  // z modułami postęp liczymy z LessonProgress — to pole zostaje 0.
  watchedSec  Int       @default(0)

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String?  @db.Text
  // INFO | SUCCESS | WARNING | BOOKING | PAYMENT | HEALTH | SPA | SYSTEM
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  subject   String
  sections  Json     @default("[]")
  category  String   @default("general")
  status    String   @default("DRAFT") // DRAFT | ACTIVE
}

// ==========================================
// MODUŁ MAILINGOWY (przenośny — patrz src/lib/mailer)
// ==========================================
//
// Modele celowo GENERYCZNE (Contact / Campaign / CampaignRecipient), bez nazw
// domenowych Rehability. Cała logika żyje w przenośnym module src/lib/mailer,
// który dotyka tych tabel WYŁĄCZNIE przez warstwę repository/prisma.ts.
// Powiązanie z domeną (User, źródła "Wydarzenia"/"VOD"/"Newsletter") realizuje
// adapter src/lib/crm/contactSync.ts — sam rdzeń mailera o tym nie wie.

// Pojedynczy kontakt mailingowy. Email jest kluczem deduplikacji — jeden adres
// = jeden Contact, niezależnie z ilu źródeł (sources[]) przyszedł.
model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?

  // SUBSCRIBED | UNSUBSCRIBED | BOUNCED | COMPLAINED
  status    String   @default("SUBSCRIBED")

  // Źródła pochodzenia, zarządzane automatycznie przez sync (np. "Wydarzenia",
  // "VOD", "Newsletter"). Kontakt może mieć wiele źródeł jednocześnie.
  sources   String[] @default([])
  // Tagi ręczne nadawane przez admina — sync ich NIE rusza.
  tags      String[] @default([])

  // Opcjonalne powiązanie z kontem użytkownika (gdy kontakt to realny User).
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Token do publicznej strony wypisania (jednorazowo generowany).
  unsubscribeToken String @unique

  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime?

  recipients CampaignRecipient[]

  @@index([status])
}

// Kampania mailingowa: treść (sekcje z edytora) + filtr audytorium + liczniki.
model Campaign {
  id        String   @id @default(cuid())
  name      String
  subject   String
  fromName  String?
  fromEmail String?

  // Sekcje z edytora maili (ten sam format co EmailTemplate.sections).
  sections  Json     @default("[]")
  // Domyślny URL przycisków CTA w tej kampanii.
  ctaUrl    String?

  // DRAFT | SCHEDULED | SENDING | SENT | FAILED
  status    String   @default("DRAFT")

  // Filtr segmentu odbiorców.
  filterSources String[] @default([])
  filterTags    String[] @default([])
  filterStatus  String   @default("SUBSCRIBED")

  scheduledAt DateTime?
  sentAt      DateTime?

  // Liczniki (cache, aktualizowane przy wysyłce i z webhooka).
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  openedCount     Int @default(0)
  bouncedCount    Int @default(0)
  failedCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients CampaignRecipient[]

  @@index([status])
}

// Pojedynczy odbiorca kampanii — kolejka wysyłki + stan dostarczenia.
model CampaignRecipient {
  id         String   @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Snapshot adresu na moment dodania do kolejki.
  email      String

  // PENDING | SENT | DELIVERED | OPENED | BOUNCED | FAILED
  status     String   @default("PENDING")

  // ID wiadomości zwrócone przez providera (Resend) — do korelacji z webhookiem.
  providerMessageId String?
  error      String?

  sentAt     DateTime?
  openedAt   DateTime?
  createdAt  DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([providerMessageId])
}

// ==========================================
// SYSTEM RABATOWY (per wydarzenie)
// ==========================================
// Trzy niezależne źródła obniżki o WSPÓLNYM cyklu życia: isActive, okno
// dat (validFrom/validUntil), limit użyć (usageLimit/usedCount) oraz
// piaskownica (isSandbox). Każdy rekord należy do DOKŁADNIE jednego
// wydarzenia — skasowanie wydarzenia kasuje jego promocje (cascade).
//
// Kwoty ZAWSZE w GROSZACH (jak Booking.amountTotal), waluta zawsze "pln".
// Pola wartości (percent / amountGrosze / targetPriceGrosze) WYKLUCZAJĄ
// SIĘ wzajemnie — przełączenie valueType zeruje nieużywane, żeby nie
// została "sierota".
//
// Reguły nakładania żyją w src/lib/discounts/calculatePrice.ts.

// WŁAŚCICIEL PROMOCJI
// Każda promocja należy do DOKŁADNIE JEDNEGO produktu: wydarzenia ALBO kursu.
// Prisma nie potrafi wyrazić „dokładnie jedno z dwóch", więc niezmiennik
// pilnujemy w warstwie zapisu (`resolveDiscountOwner` w adminWrite.ts).
//
// Uwaga o unikalności kodu: w Postgresie NULL-e w indeksie unikalnym są
// traktowane jako różne, więc @@unique([tripId, code]) nie blokuje kodów
// kursowych (tripId = NULL) — stąd druga para @@unique([courseId, code]).

// Kod rabatowy — działa dopiero po wpisaniu w koszyku.
model DiscountCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Zawsze UPPERCASE, [A-Z0-9_-], 3–32 znaki.
  code String
  // Notatka wewnętrzna admina — nigdy nie trafia do klienta.
  note String?

  // "percent" | "amount"
  valueType    String @default("percent")
  percent      Int?   // 1–95
  amountGrosze Int?   // 100–100000 (1–1000 zł)

  // true  = dokłada się DO przeceny (sekwencyjnie, na wyniku automatu)
  // false = KONKURUJE z przeceną (wygrywa niższa cena końcowa)
  stackableWithSale Boolean @default(false)

  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?

  // null = bez limitu. Limit jest MIĘKKI — dwie równoległe płatności przy
  // 19/20 obie przejdą. Twardy limit wymagałby rezerwacji miejsca na czas
  // checkoutu; to świadomy kompromis.
  usageLimit Int?
  usedCount  Int  @default(0)
  // Znacznik "wysłano powiadomienie o wyczerpaniu" — prawo do wysyłki
  // rezerwuje atomowy updateMany po exhaustedNotifiedAt: null.
  // Podniesienie limitu kasuje ten znacznik.
  exhaustedNotifiedAt DateTime?

  // Utworzone w piaskownicy — niewidoczne dla zwykłego klienta
  // (sandboxFilter wkłada isSandbox:false do WHERE, więc kod zwraca not_found).
  isSandbox Boolean @default(false)

  @@unique([tripId, code])
  @@unique([courseId, code])
  @@index([tripId, isActive])
  @@index([courseId, isActive])
}

// Przecena — działa automatycznie, bez wpisywania czegokolwiek.
model Sale {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name String
  note String?

  // "percent" | "fixed_price" (cena docelowa, NIE kwota rabatu)
  valueType         String @default("percent")
  percent           Int?   // 1–95
  targetPriceGrosze Int?   // >= 200 (minimum Stripe)

  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?

  usageLimit          Int?
  usedCount           Int  @default(0)
  exhaustedNotifiedAt DateTime?

  isSandbox Boolean @default(false)

  @@index([tripId, isActive])
  @@index([courseId, isActive])
}

// Rabat mailowy — działa automatycznie, gdy e-mail zalogowanej osoby
// znajduje się na liście członków.
model EmailDiscount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name String
  note String?

  // "percent" | "amount"
  valueType    String @default("percent")
  percent      Int?   // 1–95
  amountGrosze Int?   // 100–100000 (1–1000 zł)

  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?

  usageLimit          Int?
  usedCount           Int  @default(0)
  exhaustedNotifiedAt DateTime?

  isSandbox Boolean @default(false)

  members EmailDiscountMember[]

  @@index([tripId, isActive])
  @@index([courseId, isActive])
}

model EmailDiscountMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  emailDiscountId String
  emailDiscount   EmailDiscount @relation(fields: [emailDiscountId], references: [id], onDelete: Cascade)

  // Zawsze lowercase — porównujemy z session.user.email.toLowerCase().
  email String

  @@unique([emailDiscountId, email])
  @@index([email])
}
